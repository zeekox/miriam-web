<!--
  Index of works as a gapless grid of square thumbnails.

  `gap: 0` is the point: the images meet edge to edge and read as one continuous
  field rather than a set of cards. Because of that there are no captions here —
  the title lives on the work page. The link still carries an accessible name via
  the image's alt text, so nothing is lost to a screen reader.

  Column count is driven by container queries, so the grid responds to the space
  it is given rather than to the viewport.

  Props: works, heading, intro (optional HTML).
-->
<section class="index">
  <header class="index__header">
    <h1 class="index__heading" @text="heading"></h1>
    <div class="index__intro" webc:if="this.intro" @raw="this.intro"></div>
  </header>

  <ul class="work-grid">
    <li class="work-grid__item" webc:for="work of works">
      <a class="work-grid__link" :href="this.url(work.url)">
        <span webc:nokeep
          @html="this.picture(work.image, { alt: work.alt, sizes: '(min-width: 80rem) 25vw, (min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw', className: 'work-grid__image' })"></span>
      </a>
    </li>
  </ul>
</section>

<style webc:scoped>
  .index__header {
    padding: 1.5rem var(--gutter, 1rem) 1rem;
  }

  .index__heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
  }

  /* Keiser's density without her volume: an intro is allowed, but capped at a
     readable measure so it never competes with the work. */
  .index__intro {
    max-inline-size: 34rem;
    margin-block-start: 0.5rem;
    font-size: 0.9rem;
    color: var(--ink-muted, #5a5a5a);
    text-wrap: pretty;
  }

  /*
    The CONTAINER is .index, the wrapper — not .work-grid itself.

    A container query only styles descendants of its container; an element can
    never respond to a query on itself. With container-type on .work-grid and the
    rules also targeting .work-grid, every @container block below silently never
    matched, and the column count sat on its fallback at every width.
  */
  .index {
    container-type: inline-size;
    container-name: work-grid;
  }

  /*
    One column on a phone: a painting shown two-up on a 375px screen is barely
    180px wide, which is not looking at a painting.

    Container queries rather than media queries, because the grid should respond
    to the space it is given — but the thresholds are the project's common
    breakpoints, and since the grid is full-bleed in every current placement they
    coincide with the viewport ones. Drop it into a narrower slot and it adapts
    without this file knowing.
  */
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(var(--grid-count, 1), 1fr);
  }

  /* sm */
  @container work-grid (min-width: 40rem) {
    .work-grid { --grid-count: 2; }
  }

  /* lg */
  @container work-grid (min-width: 64rem) {
    .work-grid { --grid-count: 3; }
  }

  /* xl */
  @container work-grid (min-width: 80rem) {
    .work-grid { --grid-count: 4; }
  }

  .work-grid__link {
    display: block;
    /* Square cells, so the gapless grid stays a true lattice whatever the
       proportions of the paintings themselves. */
    aspect-ratio: 1;
    overflow: hidden;
  }

  .work-grid__link :is(img, picture) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-grid__link :is(img, picture) {
      transition: scale 400ms ease;
    }
    .work-grid__link:hover :is(img, picture),
    .work-grid__link:focus-visible :is(img, picture) {
      scale: 1.03;
    }
  }
</style>
