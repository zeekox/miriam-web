<section class="index">
  <header class="index__header shell">
    <h1 class="index__heading" @text="heading"></h1>
    <div class="index__intro prose" webc:if="this.intro" @raw="this.intro"></div>
  </header>
  <ul class="work-grid list-plain">
    <li class="work-grid__item" webc:for="work of works">
      <a class="work-grid__link media-cover" :href="this.url(work.url)">
        <span webc:nokeep
          @html="this.picture(work.image, { alt: work.alt, sizes: '(min-width: 80rem) 25vw, (min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw', className: 'work-grid__image' })"></span>
      </a>
    </li>
  </ul>
</section>
<style webc:scoped>
  .index {
    container-type: inline-size;
    container-name: work-grid;
  }

  .index__header {
    padding-block: 1.5rem 1rem;
  }

  .index__heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
  }

  .index__intro {
    margin-block-start: 0.5rem;
    font-size: var(--font-size-small);
    color: var(--ink-muted);
  }

  .work-grid {
    display: grid;
    gap: 0;
    grid-template-columns: repeat(var(--grid-count, 1), 1fr);
  }

  @container work-grid (min-width: 40rem) {
    .work-grid {
      --grid-count: 2;
    }
  }

  @container work-grid (min-width: 64rem) {
    .work-grid {
      --grid-count: 3;
    }
  }

  @container work-grid (min-width: 80rem) {
    .work-grid {
      --grid-count: 4;
    }
  }

  .work-grid__link {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-grid__link :is(img, picture) {
      transition: scale 400ms ease;
    }

    .work-grid__link:hover :is(img, picture),
    .work-grid__link:focus-visible :is(img, picture) {
      scale: 1.03;
    }
  }
</style>
