<nav id="site-menu" class="menu" popover aria-label="Primary">
  <div class="menu__head">
    <a class="menu__title link-plain" :href="this.url('/')" @text="this.site.title"></a>
    <button class="menu__close button-plain control" type="button" popovertarget="site-menu"
            popovertargetaction="hide" aria-label="Close menu">&times;</button>
  </div>
  <ul class="menu__list list-plain">
    <li class="menu__section" webc:for="section of navigation">
      <a class="menu__section-link link-plain" webc:if="section.href" :href="this.url(section.href)"
         :aria-current="this.current === section.href ? 'page' : false"
         @text="section.label"></a>
      <span class="menu__section-label" webc:else @text="section.label"></span>
      <ul class="menu__sub list-plain" webc:if="section.children && section.children.length">
        <li webc:for="item of section.children">
          <a class="menu__link link-plain" :href="this.url(item.href)"
             :aria-current="this.current === item.href ? 'page' : false"
             @text="item.label"></a>
        </li>
      </ul>
      <ul class="menu__sub list-plain" webc:if="section.includeSections && sections.length">
        <li webc:for="entry of sections">
          <a class="menu__link link-plain" :href="this.url(entry.url)"
             :aria-current="this.current === entry.url ? 'page' : false">
            <span @text="entry.data.title"></span>
            <span class="menu__count"
              @text="works.filter(w => w.section === entry.data.section).length"></span>
          </a>
        </li>
      </ul>
    </li>
  </ul>
</nav>
<style webc:scoped>
  .menu {
    position: fixed;
    inset: 0 auto 0 0;
    margin: 0;
    inline-size: min(22rem, 82vw);
    max-block-size: 100dvh;
    overflow-y: auto;
    border: 0;
    border-inline-end: 1px solid var(--rule);
    padding: 1.25rem;
    background: var(--surface);
    color: var(--ink);
    translate: -100% 0;
    opacity: 0;
    transition:
      translate var(--slide-duration) ease,
      opacity var(--slide-duration) ease,
      overlay var(--slide-duration) allow-discrete,
      display var(--slide-duration) allow-discrete;
  }

  .menu:popover-open {
    translate: 0 0;
    opacity: 1;
  }

  @starting-style {
    .menu:popover-open {
      translate: -100% 0;
      opacity: 0;
    }
  }

  .menu::backdrop {
    background: var(--scrim);
  }

  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1.5rem;
  }

  .menu__title {
    font-size: 1rem;
  }

  .menu__close {
    font-size: 1.5rem;
    line-height: 1;
  }

  .menu__section {
    margin-block-end: 1.25rem;
  }

  .menu__section-link,
  .menu__section-label,
  .menu__link {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size-inline);
  }

  .menu__section-link,
  .menu__section-label {
    font-size: 0.95rem;
  }

  .menu__sub {
    margin-block-start: 0.35rem;
    padding-inline-start: 0.9rem;
  }

  .menu__link {
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.5rem;
    font-size: var(--font-size-small);
    color: var(--ink-muted);
  }

  .menu__link:hover,
  .menu__link:focus-visible {
    color: var(--ink);
  }

  :is(.menu__link, .menu__section-link)[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .menu__count {
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu {
      transition: none;
      translate: 0 0;
    }
  }
</style>
