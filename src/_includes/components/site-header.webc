<header class="header">
  <div class="header__col header__col--left">
    <button class="header__button button-plain control" type="button" popovertarget="site-menu"
            aria-label="Open menu">
      <svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" focusable="false">
        <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.4" fill="none"/>
      </svg>
    </button>
  </div>
  <div class="header__col header__col--center">
    <a class="header__title link-plain" :href="this.url('/')" @text="this.site.title"></a>
  </div>
  <div class="header__col header__col--right"></div>
</header>
<style webc:scoped>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: [left] 1fr [center] minmax(0, max-content) [right] 1fr;
    align-items: center;
    gap: 0.5em;
    padding-inline: var(--gutter);
    block-size: var(--header-height);
    font-size: 0.875rem;
    background: color-mix(in srgb, var(--page) 92%, transparent);
    color: var(--ink);
    backdrop-filter: blur(6px);
  }

  @media (min-width: 48rem) {
    .header {
      font-size: 0.95rem;
    }
  }

  .header__col {
    display: flex;
    align-items: center;
  }

  .header__col--left {
    grid-column: left;
  }

  .header__col--center {
    grid-column: center;
    justify-content: center;
  }

  .header__col--right {
    grid-column: right;
    justify-content: flex-end;
  }

  .header__title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-inline-size: 100%;
  }

  .header__button {
    margin-inline-start: calc(var(--gutter) * -0.5);
  }
</style>
