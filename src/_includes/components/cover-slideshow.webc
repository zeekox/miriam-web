<section class="cover" aria-label="Selected works" data-carousel>
  <ul class="cover__track list-plain" tabindex="0" role="group" aria-label="Works, scrollable"
      data-carousel-track>
    <li class="cover__slide" webc:for="(slide, i) of slides" :id="`slide-${i + 1}`">
      <figure class="cover__figure media-cover">
        <media-video webc:if="slide.kind === 'video'"
                     :@mp4="slide.mp4"
                     :@poster="slide.poster"
                     :@alt="slide.alt"
                     :@autoplay="true"
                     :@decorative="true"></media-video>
        <span webc:else webc:nokeep
          @html="this.picture(slide.src, { alt: slide.alt, sizes: '100vw', className: 'cover__image', eager: true })"></span>

        <figcaption class="visually-hidden" @text="slide.alt"></figcaption>
      </figure>

      <a class="cover__arrow cover__arrow--prev control link-plain"
         :href="`#slide-${i === 0 ? slides.length : i}`"
         aria-label="Previous">‹</a>
      <a class="cover__arrow cover__arrow--next control link-plain"
         :href="`#slide-${i + 2 > slides.length ? 1 : i + 2}`"
         aria-label="Next">›</a>
    </li>
  </ul>

</section>

<style webc:scoped>
  .cover {
    position: relative;
    block-size: 100dvh;
    inline-size: 100%;
  }

  .cover::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    block-size: 7rem;
    pointer-events: none;
  }

  .cover::before {
    inset-block-start: 0;
    background: linear-gradient(to bottom, var(--scrim), transparent);
  }

  .cover__track {
    block-size: 100%;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    grid-template-rows: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .cover__track::-webkit-scrollbar {
    display: none;
  }

  .cover__slide {
    position: relative;
    block-size: 100%;
    min-block-size: 0;
    overflow: hidden;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .cover__figure {
    margin: 0;
    block-size: 100%;
    min-block-size: 0;
  }

  .cover__arrow {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
    z-index: 2;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--ink-on-image);
    text-shadow: 0 1px 3px var(--scrim);
  }

  .cover__arrow:hover,
  .cover__arrow:focus-visible {
    color: var(--accent);
  }

  .cover__arrow--prev {
    inset-inline-start: 1rem;
  }

  .cover__arrow--next {
    inset-inline-end: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__track {
      scroll-behavior: auto;
    }
  }
</style>
