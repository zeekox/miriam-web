<section class="cover" aria-label="Selected works">
  <ul class="cover__track list-plain" tabindex="0" role="group" aria-label="Works, scrollable">
    <li class="cover__slide" webc:for="(work, i) of works" :id="`slide-${i + 1}`">
      <figure class="cover__figure media-cover">
        <span webc:nokeep
          @html="this.picture(work.image, { alt: work.alt, sizes: '100vw', className: 'cover__image', eager: i === 0 })"></span>
        <figcaption class="cover__caption">
          <a class="cover__link link-plain" :href="this.url(work.url)">
            <span class="cover__title" @text="work.title"></span>
            <span class="cover__meta" webc:if="work.meta" @text="work.meta"></span>
          </a>
        </figcaption>
      </figure>
      <a class="cover__arrow cover__arrow--prev control link-plain"
         :href="`#slide-${i === 0 ? works.length : i}`"
         aria-label="Previous work">‹</a>
      <a class="cover__arrow cover__arrow--next control link-plain"
         :href="`#slide-${i + 2 > works.length ? 1 : i + 2}`"
         aria-label="Next work">›</a>
    </li>
  </ul>
</section>
<style webc:scoped>
  .cover {
    block-size: 100dvh;
    inline-size: 100%;
  }

  .cover__track {
    block-size: 100%;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .cover__track::-webkit-scrollbar {
    display: none;
  }

  .cover__slide {
    position: relative;
    block-size: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .cover__figure {
    margin: 0;
    block-size: 100%;
  }

  .cover__caption {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline: 1rem;
    background: var(--surface);
    color: var(--ink);
    padding: 0.75rem 1rem;
  }

  @media (min-width: 48rem) {
    .cover__caption {
      inset-block-end: 2rem;
      inset-inline-start: 2rem;
      inset-inline-end: auto;
      max-inline-size: min(28rem, calc(100% - 4rem));
    }
  }

  .cover__link {
    display: grid;
    gap: 0.25rem;
  }

  .cover__title {
    font-size: 1.05rem;
  }

  .cover__meta {
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .cover__arrow {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
    z-index: 2;
    font-size: 2rem;
    line-height: 1;
    color: var(--ink-on-image);
    text-shadow: var(--shadow-on-image);
  }

  .cover__arrow--prev {
    inset-inline-start: 1rem;
  }

  .cover__arrow--next {
    inset-inline-end: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__track {
      scroll-behavior: auto;
    }
  }
</style>
