<section class="cover" aria-label="Selected works">
  <ul class="cover__track list-plain" tabindex="0" role="group" aria-label="Works, scrollable">
    <li class="cover__slide" webc:for="(slide, i) of slides" :id="`slide-${i + 1}`">
      <figure class="cover__figure media-cover">
        <media-video webc:if="slide.kind === 'video'"
                     :@mp4="slide.mp4"
                     :@poster="slide.poster"
                     :@alt="slide.alt"
                     :@autoplay="true"
                     :@decorative="true"></media-video>
        <span webc:else webc:nokeep
          @html="this.picture(slide.src, { alt: slide.alt, sizes: '100vw', className: 'cover__image', eager: i === 0 })"></span>

        <figcaption class="visually-hidden" @text="slide.alt"></figcaption>
      </figure>

      <button webc:if="slide.kind === 'video'" class="cover__playback button-plain"
              type="button" data-video-toggle hidden>Pause</button>

      <a class="cover__arrow cover__arrow--prev control link-plain"
         :href="`#slide-${i === 0 ? slides.length : i}`"
         aria-label="Previous">‹</a>
      <a class="cover__arrow cover__arrow--next control link-plain"
         :href="`#slide-${i + 2 > slides.length ? 1 : i + 2}`"
         aria-label="Next">›</a>
    </li>
  </ul>
</section>

<style webc:scoped>
  .cover {
    block-size: 100dvh;
    inline-size: 100%;
  }

  .cover__track {
    block-size: 100%;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .cover__track::-webkit-scrollbar {
    display: none;
  }

  .cover__slide {
    position: relative;
    block-size: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .cover__figure {
    margin: 0;
    block-size: 100%;
  }

  .cover__playback {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-start: 1rem;
    z-index: 2;
    padding-inline: 0.5rem;
    min-block-size: var(--target-size-inline);
    font-size: var(--font-size-small);
    color: var(--ink-on-image);
    text-shadow: var(--shadow-on-image);
  }

  @media (min-width: 48rem) {
    .cover__playback {
      inset-block-end: 2rem;
      inset-inline-start: 2rem;
    }
  }

  .cover__arrow {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
    z-index: 2;
    font-size: 2rem;
    line-height: 1;
    color: var(--ink-on-image);
    text-shadow: var(--shadow-on-image);
  }

  .cover__arrow--prev {
    inset-inline-start: 1rem;
  }

  .cover__arrow--next {
    inset-inline-end: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__track {
      scroll-behavior: auto;
    }
  }
</style>
