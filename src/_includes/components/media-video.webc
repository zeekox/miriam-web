<video :class="this.decorative ? 'video video--decorative' : 'video'"
       :src="this.assetUrl(mp4)"
       :poster="this.assetUrl(poster)"
       :aria-label="this.decorative ? false : alt"
       :autoplay="this.autoplay ? true : false"
       :data-pause-when-reduced="this.autoplay ? true : false"
       :controls="this.decorative ? false : true"
       :tabindex="this.decorative ? -1 : false"
       :aria-hidden="this.decorative ? true : false"
       muted loop playsinline preload="metadata" webc:keep></video>

<style webc:scoped>
  .video {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    background: var(--ink);
  }

  .video--decorative {
    pointer-events: none;
  }
</style>
