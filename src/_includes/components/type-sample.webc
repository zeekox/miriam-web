<!--
  A titled block of text set in a named face, for comparing typefaces in place.

  The heading is always Work Sans; only the body font varies, so the comparison
  isolates one variable. The body face is passed in as a full font-family stack.

  Use from a .webc page, not a .md one: markdown-it treats an unknown custom
  element as inline and wraps it in a <p>, which would then contain this
  component's <section>.

    <type-sample @title="Roboto" @font="'Roboto', sans-serif">
      <p>Body text…</p>
    </type-sample>
-->
<section class="sample">
  <h2 class="sample__title" @text="title"></h2>
  <div class="sample__body" :style="`font-family: ${this.font}`">
    <slot></slot>
  </div>
</section>

<style webc:scoped>
  .sample {
    margin-block-end: 2.5rem;
  }

  /* Work Sans for every heading, whatever the body face is. */
  .sample__title {
    font-family: 'Work Sans', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  .sample__body {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-inline-size: 38rem;
    text-wrap: pretty;
  }

  .sample__body p {
    margin: 0;
  }
</style>
