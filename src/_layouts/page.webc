---
layout: base.webc
---
<article class="page shell">
  <h1 class="page__title" @text="this.title"></h1>
  <div class="page__body prose" @raw="this.content"></div>
  <garden-scene webc:if="this.show_garden" class="page__garden"></garden-scene>
</article>
<style webc:scoped>
  .page__title {
    margin: 0;
    padding-block: 1.5rem 1rem;
    font-size: 1rem;
    font-weight: 400;
  }

  .page__body {
    line-height: 1.65;
  }

  .page__body :is(h2, h3) {
    margin-block: 2.5rem 0.5rem;
    font-size: 1.2rem;
    font-weight: 600;
    text-wrap: balance;
  }

  .page__body :is(h2, h3):first-child {
    margin-block-start: 0;
  }

  .page__body p {
    margin-block: 0 1.1rem;
  }

  .page__garden {
    display: block;
    margin-block: 3rem;
  }
</style>
