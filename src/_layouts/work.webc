---
layout: base.webc
---
<article class="work shell">
  <header class="work__header">
    <h1 class="work__title" @text="this.title"></h1>
    <p class="work__meta" webc:if="this.metaLine" @text="this.metaLine"></p>
  </header>
  <media-video webc:if="this.video"
               class="work__video"
               :@mp4="this.video.mp4"
               :@poster="this.video.poster"
               :@alt="this.video.poster_alt"
               :@autoplay="true"></media-video>

  <div class="work__images">
    <figure class="work__figure work__figure--lead media-fit"
            :style="`--aspect: ${this.leadAspect}`">
      <button class="work__zoom button-plain" type="button" :popovertarget="`full-${this.page.fileSlug}`"
              :aria-label="`View ${this.title} full size`">
        <span webc:nokeep
          @html="this.picture(this.image, { alt: this.alt, sizes: '(min-width: 64rem) 60rem, 100vw', className: 'work__image', eager: true })"></span>
      </button>
    </figure>
    <figure class="work__figure work__figure--secondary media-fit"
            webc:for="view of (this.images || [])">
      <span webc:nokeep
        @html="this.picture(view.src, { alt: view.alt, sizes: '(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw', className: 'work__image' })"></span>
      <figcaption class="work__view-caption" @text="view.alt"></figcaption>
    </figure>
  </div>
  <div class="work__body prose" @raw="this.content"></div>
  <nav class="work__nav" aria-label="Work">
    <a :href="this.url('/works/')">All works</a>
    <a webc:if="this.sectionUrl" :href="this.url(this.sectionUrl)" @text="this.sectionLabel"></a>
  </nav>
  <div class="lightbox" :id="`full-${this.page.fileSlug}`" popover
       role="dialog" aria-modal="true" :aria-label="`${this.title}, full size`">
    <button class="lightbox__close button-plain" type="button" :popovertarget="`full-${this.page.fileSlug}`"
            popovertargetaction="hide">Close</button>
    <span webc:nokeep
      @html="this.picture(this.image, { alt: this.alt, sizes: '100vw', className: 'lightbox__image' })"></span>
  </div>
</article>
<style webc:scoped>
  .work__header {
    padding-block: 1.5rem 1rem;
  }

  .work__title {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2.3rem);
    font-weight: 400;
  }

  .work__meta {
    margin: 0.35rem 0 0;
    font-size: var(--font-size-small);
    color: var(--ink-muted);
  }

  .work__video {
    display: block;
    margin-block-end: var(--images-gap);
  }

  .work__images {
    container-type: inline-size;
    container-name: work-images;
    display: flex;
    flex-flow: row wrap;
    gap: var(--images-gap);
    align-items: flex-start;
  }

  .work__figure {
    margin: 0;
  }

  .work__figure--lead {
    flex-basis: 100%;
  }

  .work__zoom {
    display: block;
    inline-size: 100%;
    cursor: zoom-in;
  }

  @media (min-width: 48rem) {
    .work__zoom {
      inline-size: min(70vh * var(--aspect, 1), 100%);
    }
  }

  .work__figure--secondary {
    flex-basis: 100%;
  }

  @container work-images (min-width: 40rem) {
    .work__figure--secondary {
      flex-basis: calc(50% - var(--images-gap) / 2);
    }
  }

  @container work-images (min-width: 64rem) {
    .work__figure--secondary {
      flex-basis: calc(33.3333% - var(--images-gap) * 2 / 3);
    }
  }

  .work__view-caption {
    margin-block-start: 0.4rem;
    font-size: var(--font-size-meta);
    color: var(--ink-muted);
  }

  .work__body {
    padding-block: 2rem 0;
  }

  .work__nav {
    display: flex;
    gap: 1.5rem;
    padding-block: 2rem 3rem;
    font-size: var(--font-size-small);
  }
</style>
